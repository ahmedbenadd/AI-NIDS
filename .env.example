# Copy this file to `.env` and adjust. `.env` is gitignored — never commit it.
#
# The engine works with no .env at all; every value below is optional.

# Network interface to sniff on. Check yours with: ip -br link
SNIFF_INTERFACE=ens33

# Flask session key. Leave unset to auto-generate a random key per run.
# Only set this if you need sessions to survive a restart.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=
